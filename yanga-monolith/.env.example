# Server Port
PORT=3000

# fal.ai API Key for FLUX + PuLID model
FAL_KEY="your_fal_api_key_here"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Rokit Online Shared JWT Secret & API
ROKIT_JWT_SECRET="your_rokit_jwt_secret_here"
ROKIT_API_URL="https://rokitonline.com/api"

# MongoDB Database Connection
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/yanga?appName=Cluster0"

# Rokit OIDC Provider Integration
ROKIT_ISSUER_URL="https://rokitonline.com"
ROKIT_CLIENT_ID="yanga_studio"
ROKIT_CLIENT_SECRET="yanga_secret_production_key_2026"
ROKIT_REDIRECT_URI="https://yanga.rokitonline.com/api/auth/callback/rokit"

# Google OAuth Integration (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://yanga.rokitonline.com/api/auth/callback/google"

# Facebook OAuth Integration (Optional)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="https://yanga.rokitonline.com/api/auth/callback/facebook"

# Cloudflare Turnstile (Optional)
TURNSTILE_SECRET_KEY=""

# Yanga Studio Private Realism Lab Key
LAB_KEY="your_long_random_lab_key_here"
